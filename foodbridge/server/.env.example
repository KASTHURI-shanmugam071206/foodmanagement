# Server
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=foodbridge_user
DB_PASSWORD=replace_with_a_strong_password
DB_NAME=foodbridge
DB_CONNECTION_LIMIT=10

# Authentication placeholders for Stage 3
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_another_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional integrations for later stages
GOOGLE_MAPS_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
UPLOAD_MAX_SIZE_MB=5
